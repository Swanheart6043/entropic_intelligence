[Unit]
Description=Patrol Robot Maintenance Service
After=network.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/home/heyn/patrol_robot_h1_maintain
ExecStart=/home/heyn/patrol_robot_h1_maintain/runtime/main
Restart=on-failure
RestartSec=10
TimeoutStartSec=30

[Install]
WantedBy=multi-user.target