[Unit]
Description=audio_video_center
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/home/heyn/patrol_robot_h1
ExecStart=/home/heyn/patrol_robot_h1/audio_video_center
Restart=on-failure
RestartSec=10
TimeoutStartSec=30
TimeoutStopSec=15
StandardOutput=null
StandardError=null
StandardError=journal

[Install]
WantedBy=multi-user.target patrol_robot_h1.target